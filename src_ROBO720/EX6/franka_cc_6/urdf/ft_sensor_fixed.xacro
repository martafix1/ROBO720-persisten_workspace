<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ft_sensor">
  <!-- Modified FT sensor macro with fixed joint instead of revolute
       This version uses a fixed joint to avoid adding extra DOF to the kinematic chain
  -->
  <xacro:macro name="ft_sensor_fixed" params="connected_to:='' description_pkg:='franka_description' ns:='' rpy:='0 0 0' xyz:='0 0 0' safety_distance:=0">

        <link name="${ns}_ft_sensor_link">
          <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <geometry>
              <cylinder length="0.02" radius="0.04"/>
            </geometry>
          </collision>

          <visual>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
            <geometry>
              <cylinder length="0.02" radius="0.04"/>
            </geometry>
          </visual>

          <inertial>
            <mass value="0.01" />
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
          </inertial>
        </link>
    <xacro:unless value="${connected_to == ''}">
        <!-- Changed from revolute to fixed joint to avoid adding DOF -->
        <joint name="${ns}_sensor_joint" type="fixed">
          <parent link="${connected_to}"/>
          <child link="${ns}_ft_sensor_link"/>
          <origin xyz="0 0 0" rpy="${-pi/2} 0 0" />
        </joint>
      </xacro:unless>

      <link name="${ns}_tool">
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder length="0.08" radius="0.01"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="${pi} 0 0" />
        <geometry>
          <cylinder length="0.08" radius="0.01"/>
        </geometry>
      </visual>

      <inertial>
        <mass value="0.01" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
      </inertial>
    </link>

    <joint name="tool_joint" type="fixed">
      <parent link="${ns}_ft_sensor_link"/>
      <child link="${ns}_tool"/>
      <origin xyz="0 -0.05 0" rpy="${pi/2} 0 0" />
    </joint>

    <link name="${ns}_tool_ball">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.02"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <sphere radius="0.02"/>
        </geometry>
      </visual>

      <inertial>
        <mass value="0.01" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
      </inertial>
    </link>

    <joint name="tool_ball_joint" type="fixed">
      <parent link="${ns}_tool"/>
      <child link="${ns}_tool_ball"/>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
    </joint>  
  </xacro:macro>
</robot>
